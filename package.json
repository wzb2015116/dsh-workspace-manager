{
  "name": "@local/dsh-workspace-manager",
  "version": "1.0.0",
  "type": "module",
  "description": "为每个新会话按日期时间创建独立工作空间，resume 时恢复原目录；会话文件永久保留",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "workspace",
    "session",
    "working-directory"
  ],
  "license": "MIT",
  "author": "wzb2015116",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wzb2015116/dsh-workspace-manager.git"
  },
  "homepage": "https://github.com/wzb2015116/dsh-workspace-manager#readme",
  "bugs": {
    "url": "https://github.com/wzb2015116/dsh-workspace-manager/issues"
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.2-rc.5 <0.3.0-0"
  },
  "main": "src/index.js",
  "files": [
    "src/",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test \"tests/*.test.mjs\"",
    "check": "node --check src/index.js && node --check src/core.js"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
